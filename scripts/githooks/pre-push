#!/usr/bin/env bash
#
# pre-push hook (SEC-003): blocks pushes from did_rust that would orphan any
# consumer submodule pin or cargo path dependency. For every branch ref being
# pushed, every did_rust commit currently consumed by iyou_idp / iyou_home /
# iyou_mobile must remain reachable from the pushed history.
#
# Install once with: scripts/install_hooks.sh

set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
CHECKER="$HERE/../check_did_submodules.sh"
ZERO="0000000000000000000000000000000000000000"
rc=0

while read -r local_ref local_sha _remote_ref _remote_sha; do
	if [ "$local_sha" = "$ZERO" ]; then
		continue
	fi
	case "$local_ref" in
	refs/heads/*) ;;
	*) continue ;;
	esac
	echo "SEC-003 pre-push: validating consumer pins against $local_ref -> ${local_sha:0:12}"
	if ! bash "$CHECKER" --pre-push "$local_sha"; then
		rc=1
	fi
done

exit "$rc"
